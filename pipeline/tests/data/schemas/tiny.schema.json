{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiny.schema.json",
  "type": "object",
  "required": ["name", "count"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "count": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {"id": {"type": "string"}},
        "additionalProperties": false
      }
    }
  }
}
