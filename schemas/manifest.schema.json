{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attribution": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "citation": {
            "minLength": 1,
            "type": "string"
          },
          "licence": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "name",
          "licence",
          "url",
          "citation"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "behaviors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "activity": {
            "additionalProperties": false,
            "properties": {
              "binMs": {
                "const": 50,
                "type": "number"
              },
              "channels": {
                "items": {
                  "pattern": "^[A-Za-z0-9_]{1,20}$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "encoding": {
                "const": "uint8-bin-major",
                "type": "string"
              },
              "maxHz": {
                "items": {
                  "minimum": 0,
                  "type": "number"
                },
                "type": "array"
              },
              "nBins": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "url": {
                "pattern": "^(?!.*\\.\\.)[a-z0-9_\\-/.]+$",
                "type": "string"
              }
            },
            "required": [
              "url",
              "binMs",
              "nBins",
              "channels",
              "maxHz",
              "encoding"
            ],
            "type": "object"
          },
          "clipSource": {
            "enum": [
              "reference-replay",
              "policy",
              "keyframed"
            ],
            "type": "string"
          },
          "durationMs": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "id": {
            "enum": [
              "walking",
              "grooming",
              "feeding",
              "escape"
            ],
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "narrationUrl": {
            "pattern": "^(?!.*\\.\\.)[a-z0-9_\\-/.]+$",
            "type": "string"
          },
          "stimulus": {
            "additionalProperties": false,
            "properties": {
              "assumption": {
                "type": "boolean"
              },
              "cellTypes": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "description": {
                "minLength": 1,
                "type": "string"
              },
              "source": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "description",
              "cellTypes",
              "assumption",
              "source"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "label",
          "durationMs",
          "clipSource",
          "activity",
          "narrationUrl",
          "stimulus"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "body": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^(?!.*\\.\\.)[a-z0-9_\\-/.]+$",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "brain": {
      "additionalProperties": false,
      "properties": {
        "neurons": {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "cellType": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "id": {
                    "pattern": "^[A-Za-z0-9_]{1,20}$",
                    "type": "string"
                  },
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "neuropil": {
                    "pattern": "^[A-Za-z0-9_]{1,20}$",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "cellType",
                  "neuropil"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "url": {
              "pattern": "^(?!.*\\.\\.)[a-z0-9_\\-/.]+$",
              "type": "string"
            }
          },
          "required": [
            "url",
            "items"
          ],
          "type": "object"
        },
        "neuropils": {
          "additionalProperties": false,
          "properties": {
            "ids": {
              "items": {
                "pattern": "^[A-Za-z0-9_]{1,20}$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "kind": {
              "enum": [
                "mesh",
                "points"
              ],
              "type": "string"
            },
            "url": {
              "pattern": "^(?!.*\\.\\.)[a-z0-9_\\-/.]+$",
              "type": "string"
            }
          },
          "required": [
            "url",
            "kind",
            "ids"
          ],
          "type": "object"
        }
      },
      "required": [
        "neuropils",
        "neurons"
      ],
      "type": "object"
    },
    "dataSource": {
      "enum": [
        "fixture",
        "flywire-783"
      ],
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "version",
    "dataSource",
    "brain",
    "body",
    "behaviors",
    "attribution"
  ],
  "type": "object"
}
